# AI 服务配置（OpenAI 兼容接口：OpenAI / DeepSeek / 豆包 等）
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 可选：支持图片的视觉模型（推荐配置，截图识别更准）
# 可单独配置视觉模型的地址和 Key，不影响文本模型
AI_VISION_MODEL=glm-4.6v-flash
AI_VISION_MODEL_FALLBACK=glm-4.6v-flashx
AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_VISION_API_KEY=your-zhipu-api-key
# Visual channel 2: Agnes
AI_VISION_2_MODEL=agnes-2.0-flash
AI_VISION_2_MODEL_FALLBACK=agnes-2.5-flash
AI_VISION_2_BASE_URL=https://apihub.agnes-ai.com/v1
AI_VISION_2_API_KEY=your-agnes-key-1
# Visual channel 3: Agnes independent key
AI_VISION_3_MODEL=agnes-2.5-flash
AI_VISION_3_BASE_URL=https://apihub.agnes-ai.com/v1
AI_VISION_3_API_KEY=your-agnes-key-2
AI_TIMEOUT=90
# Complex images can take longer on the primary vision model. Backup models
# are intentionally shorter so the total stays below the frontend timeout.
AI_VISION_PRIMARY_TIMEOUT=60
AI_VISION_TIMEOUT=20
AI_OCR_TOTAL_TIMEOUT=110

# 前端构建产物目录（可选）。默认 frontend/dist。
# FRONTEND_DIST=D:/km-v2/frontend/dist

# —— 运行参数（均可选；下面是默认值，需要覆盖时取消注释并改值）——
# 监听地址。改 0.0.0.0 可手机/局域网访问，必须同时设置 API_TOKEN（否则同网段任何人可读写全部数据）！
# HOST=127.0.0.1
# 监听端口
# PORT=8000
# 所有 /api 与 /images/** 都要携带的口令；来源：X-API-Token 头 / Bearer / cookie km_token / ?api_token=
# API_TOKEN=
# AI 端点每分钟限流次数
# AI_RATE_LIMIT=30
# 每日复习配额（含新题），0 = 不限；复习页内可临时覆盖（存库，优先于这里）
# REVIEW_DAILY_LIMIT=50
# 慢请求阈值（毫秒）：超过打 WARN 并计入 /api/health 的慢请求统计
# SLOW_REQUEST_MS=3000
# 真题库扫描根目录
# PAPERS_DIR=D:\km-v2\真题
# 考研初试日期（统计页倒计时）；非法或已过的日期前端不显示
# EXAM_DATE=2026-12-19
