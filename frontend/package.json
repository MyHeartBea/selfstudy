{
  "name": "km-v2-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "考研错题本前端 v2 - Vue 3 自建设计系统（无 UI 框架依赖）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
